# E-commerce Storefront Environment Variables Template
# Copy this file to .env and fill in your values

# Database Connection (PostgreSQL)
# For local development: postgresql://postgres:password@localhost:5432/storefront
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/storefront"

# Better Auth (Store)
# Generate a random secret: openssl rand -base64 32
BETTER_AUTH_SECRET="your-secret-key-change-this-in-production"
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth (Optional - for Google Sign-In)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Email (Gmail SMTP — free tier)
# Enable 2-Step Verification on your Google account, then generate an
# "App Password" at https://myaccount.google.com/apppasswords
# Use THAT 16-char password here, NOT your normal Google password.
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-gmail-app-password"
SMTP_FROM="Marketplace <your-email@gmail.com>"

# Public app URL + name (used for email links + branding)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Marketplace"

# Midtrans Payment (Sandbox for development)
# Get your sandbox keys at https://dashboard.sandbox.midtrans.com/settings/config-info
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxxxxxxxxxxxxxxxxxx"
MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxxxxxxxxxxxxx"
MIDTRANS_IS_PRODUCTION="false"
# Test-only authoritative status boundary; ignored when NODE_ENV=production.
MIDTRANS_MOCK_API_BASE_URL=""

# Cron secret for the stock-reservation sweep endpoint
# (POST /api/cron/sweep-reservations, header X-Cron-Secret). Generate with:
#   openssl rand -hex 32
CRON_SECRET="change-me"

# Jubelio API — master-data sync (source of truth for products/stock/images).
# APP_ENV is an independent safety boundary because staging also builds Next.js
# with NODE_ENV=production. Legacy adjustment writes use the mock outside
# production; the new (unwired) Sales gateway instead fails closed by default.
APP_ENV="development"
# Login creds for https://api2.jubelio.com (catalog reads and approved live writes).
JUBELIO_API_BASE_URL="https://api2.jubelio.com"
JUBELIO_MOCK_API_BASE_URL="http://127.0.0.1:3002"
JUBELIO_EMAIL="change-me"
JUBELIO_PASSWORD="change-me"
JUBELIO_CHANNEL_ID="64"
# Production-only kill switch. Keep false in development/staging.
JUBELIO_STOCK_WRITES_ENABLED="false"
# New Sales gateway ONLY: default-off explicit real test-account opt-in outside
# production; the base URL is pinned to https://api2.jubelio.com and the
# credentials must be the isolated test account.
# Production ignores this flag and requires the separate production write gate.
JUBELIO_SALES_TEST_ACCOUNT_ENABLED="false"
# Mock-only Playwright sets E2E_PROVIDER_MOCKS and JUBELIO_SALES_MOCK_API_BASE_URL
# itself (bare HTTP loopback only). Do not enable them in application deployments.

# Jubelio Shipment API (host terpisah: api-shipment.jubelio.com; sandbox:
# api-shipment.sandbox.jubelio.com) — BUKAN Omnichannel. Kredensial
# client_id/client_secret dari proses integrasi Jubelio Shipment.
# Catatan pemilik 2026-09-27: kredensial ini adalah kredensial SANDBOX tenant yang dioperasikan
# melalui URL api-shipment.jubelio.com (tenant masih mode mock — AWB berprefix MOCK-). Host
# sandbox publik (api-shipment.sandbox.jubelio.com) tidak mengenali akun ini.
# Isi kredensial hanya di .env lokal; jangan pernah dikirim lewat chat atau di-commit.
# Host tenant ini menggunakan URL produksi meski kredensialnya sandbox/mode mock.
JUBELIO_SHIPMENT_URL="https://api-shipment.jubelio.com"
JUBELIO_SHIPMENT_CLIENT_ID=""
JUBELIO_SHIPMENT_CLIENT_SECRET=""
JUBELIO_SHIPMENT_TIMEOUT_MS=10000
# Dedicated Shipment callback secret; never reuse Omnichannel/API credentials.
JUBELIO_SHIPMENT_WEBHOOK_SECRET=""
# Sales-order settlement (Path 1: SO → invoice → payment). The payment account
# id must be a real cash/bank account id of the target Jubelio account; blank
# routes invoice payments to manual review (fail closed).
JUBELIO_PAYMENT_ACCOUNT_ID=""
# Payment type label recorded on POST /sales/payments/ (default "transfer").
JUBELIO_PAYMENT_TYPE="transfer"
# Item unit recorded on Sales Order lines (default "Buah").
JUBELIO_ITEM_UNIT=Buah
# Jubelio tax record id for Sales Order lines (must reference a real tax
# record; tax_id 0 fails the provider FK). Sandbox: 1 = "No Tax" (rate 0.00).
JUBELIO_ITEM_TAX_ID=1
# Optional emergency overrides; blank uses /systemsetting/account-mapping.
JUBELIO_ADJUSTMENT_PLUS_ACCOUNT_ID=""
JUBELIO_ADJUSTMENT_MINUS_ACCOUNT_ID=""
JUBELIO_STOCK_TIMEOUT_MS="8000"
# Keep headroom below Jubelio's documented 600 requests/minute provider limit.
JUBELIO_STOCK_MAX_REQUESTS_PER_MINUTE="450"
JUBELIO_STOCK_CONCURRENCY="10"
JUBELIO_STOCK_MAX_QUEUED="1000"
JUBELIO_STOCK_QUEUE_TIMEOUT_MS="5000"
# Webhook signature secret (POST /api/webhooks/jubelio). Generate with:
#   openssl rand -hex 32
JUBELIO_WEBHOOK_SECRET="change-me"
# Local/staging target used by `npm run jubelio:webhook`.
JUBELIO_WEBHOOK_URL="http://localhost:3000/api/webhooks/jubelio"
# Optional simulator controls: action = random|update-product|update-price|update-qty.
JUBELIO_SIMULATOR_ACTION="random"
JUBELIO_SIMULATOR_PAGE_SIZE="100"
# Parallel catalog fetches during a full import (default 5).
JUBELIO_SYNC_CONCURRENCY="5"
# Cap products synced by `db:import-jubelio` for fast dev testing.
# EMPTY = fetch ALL products from Jubelio; an integer = stop after N products.
JUBELIO_SYNC_MAX_PRODUCTS=""
# Seeder catalog source: demo (dummy catalog/branches) or jubelio (skip them,
# then run `npm run db:import-jubelio`). Seeder remains blocked in production.
SEED_MODE="demo"

UPLOADS_DIR=""

# Public URL of the storefront app (used by admin to display images served by the store)
NEXT_PUBLIC_STORE_URL="http://localhost:3000"
