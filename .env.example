# E-commerce Storefront Environment Variables Template
# Copy this file to .env and fill in your values

# Database Connection (PostgreSQL)
# For local development: postgresql://postgres:password@localhost:5432/storefront
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/storefront"

# Better Auth (Store)
# Generate a random secret: openssl rand -base64 32
BETTER_AUTH_SECRET="your-secret-key-change-this-in-production"
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth (Optional - for Google Sign-In)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Email (Gmail SMTP — free tier)
# Enable 2-Step Verification on your Google account, then generate an
# "App Password" at https://myaccount.google.com/apppasswords
# Use THAT 16-char password here, NOT your normal Google password.
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-gmail-app-password"
SMTP_FROM="Marketplace <your-email@gmail.com>"

# Public app URL + name (used for email links + branding)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Marketplace"

# Midtrans Payment (Sandbox for development)
# Get your sandbox keys at https://dashboard.sandbox.midtrans.com/settings/config-info
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxxxxxxxxxxxxxxxxxx"
MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxxxxxxxxxxxxx"
MIDTRANS_IS_PRODUCTION="false"

# Cron secret for the stock-reservation sweep endpoint
# (POST /api/cron/sweep-reservations, header X-Cron-Secret). Generate with:
#   openssl rand -hex 32
CRON_SECRET="change-me"

# Jubelio API — master-data sync (source of truth for products/stock/images).
# Login creds for https://api2.jubelio.com (read-only usage).
JUBELIO_API_BASE_URL="https://api2.jubelio.com"
JUBELIO_EMAIL="change-me"
JUBELIO_PASSWORD="change-me"
JUBELIO_CHANNEL_ID="64"
# Webhook signature secret (POST /api/webhooks/jubelio). Generate with:
#   openssl rand -hex 32
JUBELIO_WEBHOOK_SECRET="change-me"
# Parallel catalog fetches during a full import (default 5).
JUBELIO_SYNC_CONCURRENCY="5"
# Cap products synced by `db:import-jubelio` for fast dev testing.
# EMPTY = fetch ALL products from Jubelio; an integer = stop after N products.
JUBELIO_SYNC_MAX_PRODUCTS=""

UPLOADS_DIR=""

# Public URL of the storefront app (used by admin to display images served by the store)
NEXT_PUBLIC_STORE_URL="http://localhost:3000"