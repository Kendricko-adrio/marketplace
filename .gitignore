# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright/
# Legacy output paths: keep ignored as a safeguard for old commands.
/test-results/
/playwright-report/
/playwright-report-mock/
/blob-report/
/e2e/.auth/

# next.js
.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
# Block semua .env* asli (secret), tapi COMMIT template *.example.
# Tanpa exception ini, `cp deployment/staging/.env.example .env` di VPS
# akan gagal karena template tidak ter-track oleh git.
.env*
!.env.example
!.env.*.example

# uploaded files
public/uploads/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# build output (tsc) dari packages
dist/

.playwright-mcp

# Pi project MCP config (.pi/mcp.json) is tracked; ignore local/generated files
.pi/mcp-traces/
.pi/settings.json
.tmp
