# Secret env — JANGAN commit (file asli `.env` di tiap folder env).
# Template `.env.example` tetap di-commit (di-reinclude oleh root .gitignore).
staging/.env
production/.env

# Caddy persistent state (sertifikat, config) — di-mount via named volume,
# tapi kalau ada folder lokal yang tertinggal, ignore.
staging/caddy/data
staging/caddy/config
production/caddy/data
production/caddy/config
