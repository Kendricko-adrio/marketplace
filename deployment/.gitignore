# Secret env — JANGAN commit (file asli `.env` di tiap folder env).
# Template `.env.example` tetap di-commit (di-reinclude oleh root .gitignore).
staging/.env
production/.env
staging/.env.*
!staging/.env.example

# Manifest aktual staging dan secret bootstrap tidak boleh masuk Git.
staging/bootstrap.config.json
staging/bootstrap.config.*.json
!staging/bootstrap.config.example.json
staging/secrets/
staging/*.password
staging/*.secret

# Manifest bootstrap production yang sudah terisi (non-secret, tetap lokal).
# Template bootstrap.config.example.json tetap di-commit.
production/bootstrap.config.json
production/bootstrap.config.*.json
!production/bootstrap.config.example.json

# Secret bootstrap (file password Owner, dsb). Jangan pernah di-commit.
production/secrets/
production/*.password
production/*.secret

# Caddy persistent state (sertifikat, config) — di-mount via named volume,
# tapi kalau ada folder lokal yang tertinggal, ignore.
staging/caddy/data
staging/caddy/config
production/caddy/data
production/caddy/config
