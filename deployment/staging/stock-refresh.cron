# Crontab deploy, 02:00 UTC host setiap hari, hanya setelah tenant/data bersih.
# Ganti --runs 1 dengan max(1, ceil(eligible item IDs / 20000)), maksimal 12.
# Satu lock mencakup seluruh rangkaian; kegagalan menghentikan run berikutnya.
0 2 * * * /home/ops/marketplace/deployment/common/cron/refresh-jubelio-stock.sh --url https://dev-store.adfsport.cloud --env-file /home/ops/marketplace/deployment/staging/.env --log-dir /home/ops/log/marketplace-stock-refresh/staging --runs 1
