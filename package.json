{
  "name": "marketplace-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "defu": "6.1.7",
    "linkify-it": "5.0.2",
    "picomatch@2.3.1": "2.3.2"
  },
  "scripts": {
    "dev": "npm run dev:store",
    "dev:jubelio-mock": "npm run dev --workspace @marketplace/jubelio-mock",
    "jubelio:webhook": "npm run simulate --workspace @marketplace/jubelio-webhook-simulator",
    "dev:store:app": "cd apps/store && npm run dev",
    "dev:admin:app": "cd apps/admin && npm run dev",
    "dev:store": "concurrently \"npm run dev:jubelio-mock\" \"npm run dev:store:app\"",
    "dev:admin": "npm run dev:admin:app",
    "dev:all": "concurrently \"npm run dev:jubelio-mock\" \"npm run dev:store:app\" \"npm run dev:admin:app\"",
    "build": "npm run build:packages && npm run build:store && npm run build:admin",
    "build:packages": "npm run build --workspace @marketplace/db && npm run build --workspace @marketplace/ui",
    "build:store": "cd apps/store && npm run build",
    "build:admin": "cd apps/admin && npm run build",
    "db:generate": "cd packages/db && npm run db:generate",
    "db:push": "cd packages/db && npm run db:push",
    "db:migrate": "cd packages/db && npm run db:migrate",
    "db:studio": "cd packages/db && npm run db:studio",
    "db:seed": "cd packages/db && npm run db:seed",
    "db:check": "cd packages/db && npm run db:check",
    "db:reset": "cd packages/db && npm run db:reset",
    "db:import-jubelio": "cd packages/db && npm run db:import-jubelio",
    "lint": "cd apps/store && npm run lint && cd ../admin && npm run lint",
    "lint:store": "cd apps/store && npm run lint",
    "lint:admin": "cd apps/admin && npm run lint",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:install": "playwright install",
    "test:e2e:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "concurrently": "^8.2.2",
    "vitest": "^4.1.10"
  }
}
